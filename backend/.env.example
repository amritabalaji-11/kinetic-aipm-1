# Allowed CORS origin for the frontend (currently set to * in main.py for dev)
FRONTEND_ORIGIN=http://localhost:5173

# Google Cloud Storage bucket name
GCS_BUCKET_NAME=kinetic_bucket

# Path to GCS service account key (relative to backend/)
# GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json

# Anthropic API key — used for Haiku Call 1 (form analysis) and Haiku Call 2 (progression)
ANTHROPIC_API_KEY=sk-ant-...

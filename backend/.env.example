# Kinetic AIPM - Backend Configuration
# Copy this file to backend/.env and fill in your credentials

# Frontend Configuration
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=credentials/kinetic-backend-495415-8cc8d53e4cd0.json

# Google Cloud Storage bucket name
GCS_BUCKET_NAME=kinetic_bucket

# Anthropic API
# Used for Haiku Call 1 (form analysis) and Haiku Call 2 (progression)
ANTHROPIC_API_KEY=your-anthropic-api-key
HAIKU_MODEL=claude-haiku-4-5

# Database Configuration
DATABASE_URL=sqlite:///kinetic.db

# FastAPI Configuration
DEBUG=true
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Video Processing
MAX_VIDEO_SIZE_MB=500
ALLOWED_VIDEO_FORMATS=mp4,mov,avi,mkv
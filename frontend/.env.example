# URL of the running backend. In dev the Vite proxy handles /upload, /analysis,
# and /health automatically, so this variable is only needed when pointing at a
# remote backend (e.g. staging or production Cloud Run URL).
VITE_API_URL=http://localhost:8000

# Google OAuth Web client ID (same one the backend uses as GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=
